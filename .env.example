# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=apoema
DB_PASSWORD=apoema_dev_password
DB_NAME=apoema_db

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# Application Configuration
APP_PORT=8000
PYTHONUNBUFFERED=1

# LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Ollama Configuration (if using local Ollama)
# OLLAMA_HOST is used by docker-compose (service hostname); OLLAMA_BASE_URL is used
# by RagManager for embeddings. OLLAMA_MODEL must support tool calling (e.g. phi4-mini:3.8b).
# OLLAMA_VISION_MODEL is used by the plot analyst to read PNG charts (vision-capable).
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini:3.8b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# RAG Configuration
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIM=768
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_RESULTS=5