# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=apoema
DB_PASSWORD=apoema_dev_password
DB_NAME=apoema_db
# Connection pool (psycopg_pool) — reuses DB connections instead of opening a
# fresh one per query. Without a pool the FIFO backoff loop churned ~27k
# TIME_WAIT sockets and exhausted the ephemeral-port range (intermittent
# "Cannot assign requested address").
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:***@rabbitmq:5672///

# Application Configuration
APP_PORT=8000
PYTHONUNBUFFERED=1
# Controls uvicorn auto-reload (run_api.py: reload=config.DEBUG). Leave false in
# Docker — with reload on, ANY bind-mounted code change (e.g. a git pull that
# touches api/*) makes uvicorn re-import and, if the image wasn't rebuilt with
# new deps, kill the server on an import error. Set true only for host dev.
DEBUG=false
# ENV selects the config class (development|production|testing). Defaults to
# development when unset. The compose file passes DEBUG=false; the classes now
# honor the DEBUG env instead of hardcoding, so this is what actually governs.
ENV=production

# ── LLM Providers (see MODEL_ALTERNATIVES_STUDY.md) ─────────────────────────
# Set the key for the provider you want; submit analyses with the matching
# "model" value. Recommended: gemini (cheap, multimodal, large context).
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Default model submitted to the analysis API when none is given.
DEFAULT_MODEL=ollama

# ── Ollama (local, offline fallback) ────────────────────────────────────────
# OLLAMA_HOST is used by docker-compose (service hostname); OLLAMA_BASE_URL is
# used as the LLM endpoint fallback. OLLAMA_MODEL must support tool calling.
# OLLAMA_VISION_MODEL reads PNG charts (vision-capable).
#
# OLLAMA_MODEL: pick ONE.
#   qwen2.5:3b (1.9GB) — recommended for CPU-only machines / <8GB VRAM.
#   qwen2.5:7b (4.7GB) — recommended for GPU machines (fits an RTX 4060 8GB).
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_MODEL=qwen2.5:7b  # use this one on GPU machines (RTX 4060 8GB)
OLLAMA_VISION_MODEL=qwen2.5vl:3b
# Cap on generated tokens per task for ollama. Without it, a degenerate run
# generates until EOS/context fill (observed 49K+ tokens) and stalls the worker
# mid-response. Legitimate task outputs are ~1-2K tokens; 2048 is generous.
OLLAMA_MAX_TOKENS=2048

# ── Zombie watchdog (automatic cleanup) ─────────────────────────────────────
# Analyses stuck in 'processing'/'queued' for longer than the threshold block
# the FIFO queue forever. The watchdog (runs inside the API app) marks them
# 'failed' and purges the RabbitMQ queues every interval. 30 min = longest
# observed legitimate run. Set ZOMBIE_WATCHDOG_INTERVAL=0 to disable.
ZOMBIE_WATCHDOG_INTERVAL=1800
ZOMBIE_WATCHDOG_THRESHOLD=1800

# ── Report ingestion (APOEMA published reports) ─────────────────────────────
# Download timeout (seconds) for chart PNGs. The chart route (port 443) is
# behind the USP VPN and may hang from outside it; a short timeout keeps the
# ingest (single or batch) from stalling on unreachable charts.
APOEMA_CHART_PNG_TIMEOUT=30

# Embedding model for CrewAI's native Knowledge feature.
RAG_EMBEDDING_MODEL=nomic-embed-text

# ── GPU (NVIDIA) ────────────────────────────────────────────────────────────
# Enable with: docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
# (the override mounts the GPU; layer offload is automatic in modern ollama).

# ── Google Drive ficha ingestion ────────────────────────────────────────────
# Public CAPES ficha folder. On every app start (DRIVE_AUTO_INGEST=true) the
# API enumerates/downloads new fichas/anexos and enqueues their conversion.
# POST /api/fichas/ingest re-runs it on demand. Both are idempotent.
DRIVE_FOLDER_ID=1AI8fJoE9PU366xdGA0Af0kmiS3PdGsVb
DRIVE_AUTO_INGEST=true
