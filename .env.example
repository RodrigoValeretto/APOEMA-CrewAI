# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=apoema
DB_PASSWORD=apoema_dev_password
DB_NAME=apoema_db

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:***@rabbitmq:5672///

# Application Configuration
APP_PORT=8000
PYTHONUNBUFFERED=1

# ── LLM Providers (see MODEL_ALTERNATIVES_STUDY.md) ─────────────────────────
# Set the key for the provider you want; submit analyses with the matching
# "model" value. Recommended: gemini (cheap, multimodal, large context).
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here
# Default model submitted to the analysis API when none is given.
DEFAULT_MODEL=ollama

# ── Ollama (local, offline fallback) ────────────────────────────────────────
# OLLAMA_HOST is used by docker-compose (service hostname); OLLAMA_BASE_URL is
# used as the LLM endpoint fallback. OLLAMA_MODEL must support tool calling
# (e.g. phi4-mini:3.8b). OLLAMA_VISION_MODEL reads PNG charts (vision-capable).
OLLAMA_HOST=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini:3.8b
OLLAMA_VISION_MODEL=qwen2.5vl:3b

# Embedding model for CrewAI's native Knowledge feature.
RAG_EMBEDDING_MODEL=nomic-embed-text
